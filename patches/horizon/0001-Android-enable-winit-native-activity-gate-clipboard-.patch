+/// The system clipboard on Android: there is no backend, so text copied in the game can still be
+/// pasted in the game (the same fallback as when no system clipboard can be reached).
+#[cfg(target_os = "android")]
+#[derive(Default)]
+pub struct SystemClipboard {
+    /// The text Horizon last copied (`horizon-ctl status`).
+    copied: Option<String>,
+}
+
+#[cfg(target_os = "android")]
+impl SystemClipboard {
+    /// The text last copied by the game.
+    pub fn copied(&self) -> Option<&str> {
+        self.copied.as_deref()
+    }
+}
+
+#[cfg(target_os = "android")]
+impl Clipboard for SystemClipboard {
+    fn get(&mut self) -> String {
+        self.copied.clone().unwrap_or_default()
+    }
+    fn set(&mut self, text: &str) {
+        if !text.is_empty() {
+            self.copied = Some(text.to_owned());
+        }
+    }
+}
+
 /// A clipboard in memory.
 #[derive(Default, Debug)]
 pub struct MemoryClipboard(pub String);
