 crates/horizon-client/src/game.rs             |  2 +-
 .../horizon-client/src/game/loading_screen.rs |  2 +-
 .../horizon-client/src/game/no_resources.rs   |  2 +-
 .../src/game/resource_loader.rs               |  2 +-
 5 files changed, 45 insertions(+), 4 deletions(-)

diff --git a/crates/horizon-client/src/entry.rs b/crates/horizon-client/src/entry.rs
index b56d910..9752dda 100644
--- a/crates/horizon-client/src/entry.rs
+++ b/crates/horizon-client/src/entry.rs
@@ -6,6 +6,47 @@ pub fn main() {
     main_with(Default::default());
 }
 
+/// The Android app handle (`android_main`'s), kept for the event loop every screen builds.
+#[cfg(target_os = "android")]
+pub static ANDROID_APP: std::sync::OnceLock<winit::platform::android::activity::AndroidApp> =
+    std::sync::OnceLock::new();
+
+/// The event loop each screen runs on. winit builds one from the `AndroidApp` on Android and
+/// from the display server elsewhere.
+pub fn event_loop() -> Result<winit::event_loop::EventLoop<()>, winit::error::EventLoopError> {
+    #[cfg(target_os = "android")]
+    {
+        use winit::platform::android::EventLoopBuilderExtAndroid;
+        let app = ANDROID_APP
+            .get()
+            .expect("`run_android` stores the app before the first screen")
+            .clone();
+        winit::event_loop::EventLoop::builder()
+            .with_android_app(app)
+            .build()
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        winit::event_loop::EventLoop::new()
+    }
+}
+
+/// Start the game from an Android `NativeActivity`. The game folder is the app's own external
+/// files folder (`Android/data/<package>/files`): saves, `options.txt` and the prepared game
+/// files (`.local/horizon-client/26.3`, pushed from a PC) are all relative to the working
+/// directory.
+#[cfg(target_os = "android")]
+pub fn run_android(app: winit::platform::android::activity::AndroidApp) {
+    if let Some(dir) = app.external_data_path() {
+        let _ = std::fs::create_dir_all(&dir);
+        if let Err(err) = std::env::set_current_dir(&dir) {
+            log::error!("cannot enter {}: {err}", dir.display());
+        }
+    }
+    let _ = ANDROID_APP.set(app);
+    main();
+}
+
